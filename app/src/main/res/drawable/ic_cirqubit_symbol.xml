<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Stylized 'C' arc -->
    <path
        android:pathData="M 58.8,34.7 A 20,20 0 1,0 58.8,65.3"
        android:strokeWidth="7"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="46"
                android:startY="20"
                android:endX="46"
                android:endY="80"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#0091FF" android:offset="0.5" />
                <item android:color="#0062FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upper Circuit Trace with 45 degree angle -->
    <path
        android:pathData="M 26,50.5 L 40,50.5 L 45.5,45.0 L 71.5,45.0"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="45"
                android:endX="72"
                android:endY="45"
                android:type="linear">
                <item android:color="#00D2FF" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lower Circuit Trace -->
    <path
        android:pathData="M 44.5,55.5 L 71.5,55.5"
        android:strokeWidth="4.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="44"
                android:startY="55"
                android:endX="72"
                android:endY="55"
                android:type="linear">
                <item android:color="#0088FF" android:offset="0.0" />
                <item android:color="#00B0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upper Terminal Ring -->
    <path
        android:pathData="M 76,45 m -4.5,0 a 4.5,4.5 0 1,1 9,0 a 4.5,4.5 0 1,1 -9,0"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3.2" />

    <!-- Lower Terminal Ring -->
    <path
        android:pathData="M 76,55.5 m -4.5,0 a 4.5,4.5 0 1,1 9,0 a 4.5,4.5 0 1,1 -9,0"
        android:strokeColor="#0099FF"
        android:strokeWidth="3.2" />
</vector>
